    {
      "parameters": {
        "jsCode": "// PH paydays are the 15th and end of month; regular reminders go out 1-3 days after\nconst PAYDAY_WINDOW = [1, 2, 3, 16, 17, 18];\n// regular + special non-working days; check each year's proclamation (Eid dates move, add them when announced)\nconst PH_HOLIDAYS = [\n  '2026-01-01', '2026-02-17', '2026-04-02', '2026-04-03', '2026-04-04', '2026-04-09', '2026-05-01', '2026-06-12',\n  '2026-08-21', '2026-08-31', '2026-11-01', '2026-11-02', '2026-11-30', '2026-12-08', '2026-12-24', '2026-12-25', '2026-12-30', '2026-12-31',\n  '2027-01-01', '2027-02-06', '2027-03-25', '2027-03-26', '2027-03-27', '2027-04-09', '2027-05-01', '2027-06-12',\n  '2027-08-21', '2027-08-30', '2027-11-01', '2027-11-02', '2027-11-30', '2027-12-08', '2027-12-24', '2027-12-25', '2027-12-30', '2027-12-31',\n];\nconst ts = $('Schedule Trigger').first().json.timestamp;\nconst today = (ts ? DateTime.fromISO(ts) : DateTime.now()).setZone('Asia/Manila');\n// no customer emails on Sundays or holidays\nif (today.weekday === 7 || PH_HOLIDAYS.includes(today.toISODate())) return [];\nconst afterPayday = PAYDAY_WINDOW.includes(today.day);\nconst all = $input.all().map(i => i.json);\n\n// promise score per customer, summed over all their invoices\nconst score = {};\nfor (const j of all) {\n  const s = score[j.email] ??= { kept: 0, broken: 0 };\n  s.kept += j.promises_kept || 0;\n  s.broken += j.promises_broken || 0;\n}\n\nreturn all\n  .filter(j => {\n    const due = DateTime.fromISO(j.due_date);\n    const last = j.last_contact ? DateTime.fromISO(j.last_contact) : null;\n    // promise counts as broken 1 day after the promised date\n    const broken = j.status === 'promised' && j.promise_date &&\n      DateTime.fromISO(j.promise_date).plus({ days: 1 }) < today;\n    // broken promises are chased right away; normal reminders wait for payday\n    return ((j.status === 'open' && afterPayday) || broken) && due < today && j.stage < 3 &&\n      (!last || today.diff(last, 'days').days >= 3);\n  })\n  .map(j => {\n    const s = score[j.email];\n    const total = s.kept + s.broken;\n    return { json: { ...j,\n      broken_promise: j.status === 'promised',\n      days_overdue: Math.floor(today.diff(DateTime.fromISO(j.due_date), 'days').days),\n      reliability: total === 0 ? 'new' : s.kept >= s.broken ? 'reliable' : 'unreliable',\n      score_badge: total === 0 ? '🆕 no promises yet' : `${s.kept >= s.broken ? '✅' : '⚠️'} kept ${s.kept}/${total} promises` } };\n  });"
      },
