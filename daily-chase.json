      "parameters": {
        "jsCode": "// a promise is kept if the owner marked it paid by the end of the day after the promised date\nreturn $input.all().map(i => i.json)\n  .filter(j => j.status === 'paid' && j.promise_date)\n  .map(j => ({ json: { invoice_id: j.invoice_id,\n    promises_kept: (j.promises_kept || 0) +\n      (DateTime.fromISO(j.updatedAt) <= DateTime.fromISO(j.promise_date).endOf('day').plus({ days: 1 }) ? 1 : 0) } }));"
