    {
      "parameters": {
        "jsCode": "// stage 3 = all reminders sent; list them once a day for a phone call\nconst today = DateTime.now();\nconst rows = $input.all().map(i => i.json)\n  .filter(j => j.stage >= 3 && (j.status === 'open' || j.status === 'promised'));\nif (!rows.length) return [];\nconst lines = rows.map(j => `• ${j.invoice_id} ${j.customer}: PHP ${j.amount}, ${Math.floor(today.diff(DateTime.fromISO(j.due_date), 'days').days)} days overdue`);\nreturn [{ json: { text: `📞 Call these (3 reminders sent, still unpaid):\\n${lines.join('\\n')}` } }];"
      },
