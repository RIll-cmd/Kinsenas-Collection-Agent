      "parameters": {
        "promptType": "define",
        "text": "=Write a short, polite payment reminder email.\nStage {{ $json.stage }}: 0 = friendly, 1 = firmer, 2 = offer a payment plan.\nCustomer: {{ $json.customer }}\nInvoice: {{ $json.invoice_id }}, amount PHP {{ $json.amount }}, {{ $json.days_overdue }} days overdue.\nNo threats. Sign as \"Accounts Team\".\nOnly use line breaks between paragraphs, never inside a sentence.\n{{ $json.broken_promise ? 'The customer promised to pay on ' + $json.promise_date + ' but has not paid. Mention this politely.' : '' }}\n{{ $json.reliability === 'reliable' ? 'This customer usually keeps payment promises: be warm and appreciative.' : $json.reliability === 'unreliable' ? 'This customer often breaks payment promises: be clear and firm, still polite.' : '' }}\n{{ $json.notes ? 'Owner note about this customer (follow it): ' + $json.notes : '' }}",
