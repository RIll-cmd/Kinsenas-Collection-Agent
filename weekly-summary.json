    {
      "parameters": {
        "jsCode": "const now = DateTime.now().setZone('Asia/Manila');\nconst rows = $input.all().map(i => i.json);\nconst peso = n => 'PHP ' + Math.round(n).toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\nconst sum = list => list.reduce((s, j) => s + (Number(j.amount) || 0), 0);\nconst unpaid = rows.filter(j => j.status === 'open' || j.status === 'promised');\nconst promised = unpaid.filter(j => j.status === 'promised' && j.promise_date && DateTime.fromISO(j.promise_date) <= now.plus({ days: 7 }));\n// paid date = when the row was last edited; close enough since status is set by hand\nconst collected = rows.filter(j => j.status === 'paid' && DateTime.fromISO(j.updatedAt) >= now.minus({ days: 7 }));\nconst calls = unpaid.filter(j => j.stage >= 3);\nconst lines = [\n  `📊 Weekly summary (${now.toFormat('MMM d')})`,\n  `💸 Still owed: ${peso(sum(unpaid))} (${unpaid.length} invoices)`,\n  `🤝 Promised this week: ${peso(sum(promised))} (${promised.length})`,\n  ...promised.map(j => `   • ${j.invoice_id} ${j.customer} on ${j.promise_date}`),\n  `✅ Collected last 7 days: ${peso(sum(collected))} (${collected.length})`,\n  `📞 Need a call: ${calls.length}`,\n];\nreturn [{ json: { text: lines.join('\\n') } }];"
      },
