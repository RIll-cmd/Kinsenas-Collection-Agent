    {
      "parameters": {
        "jsCode": "// shortcut: assumes one receipt email per poll (Gmail polls every minute); split per item if volume grows\nconst r = $('Parse receipt').first().json;\nconst inv = $('Get invoice').first().json;\nconst invoiceId = $('Edit Fields').first().json.invoice_id || '(no invoice ID)';\nconst seen = $('Find same ref').all().map(i => i.json).filter(j => j.ref);\nconst now = DateTime.now();\nconst flags = [];\nif (r.parse_error || r.is_receipt === false) flags.push('❓ does not look like a payment receipt');\nif (!r.ref_no) flags.push('❓ no reference number found');\nif (seen.length) flags.push(`🚩 reference ${r.ref_no} was already used for ${seen.map(s => s.invoice_id).join(', ')}`);\nif (inv.amount != null && r.amount != null && Number(r.amount) !== Number(inv.amount)) flags.push(`🚩 amount PHP ${r.amount} does not match invoice PHP ${inv.amount}`);\nif (r.date) {\n  const d = DateTime.fromISO(r.date);\n  if (d > now.plus({ days: 1 })) flags.push('🚩 receipt date is in the future');\n  if (d < now.minus({ days: 60 })) flags.push('🚩 receipt is more than 60 days old');\n}\nif (r.notes) flags.push(`👀 ${r.notes}`);\nconst text = `🧾 Receipt check: ${invoiceId}\\n${r.app || '?'} · ref ${r.ref_no || '?'} · PHP ${r.amount ?? '?'} · ${r.date || '?'} ${r.time || ''}\\n\\n${flags.length ? flags.join('\\n') : '✅ no red flags found'}\\n\\nStill check your GCash/bank app before marking paid.`;\nreturn [{ json: { text, ref: r.ref_no, invoice_id: invoiceId, amount: Number(r.amount) || null, app: r.app || '' } }];"
      },
