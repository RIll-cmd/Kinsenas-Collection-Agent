    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Gemini answers as text; pull the JSON object out of whichever field holds it\nconst find = v => typeof v === 'string' ? (v.includes('{') ? v : null)\n  : v && typeof v === 'object' ? (Object.values(v).map(find).find(Boolean) ?? null) : null;\nconst text = find($json) || '{}';\nlet r;\ntry { r = JSON.parse(text.slice(text.indexOf('{'), text.lastIndexOf('}') + 1)); }\ncatch (e) { r = { parse_error: true }; }\nreturn { json: { ...r, ref_no: String(r.ref_no || '').replace(/\\s/g, '') } };"
      },
      "id": "8a75ca71-0685-4060-9c28-e6a2263c5456",
      "name": "Parse receipt",
